# ==========================================
# LearnTrack — Production Root .gitignore
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.*

# Build & Bundler Artifacts (Root, Frontend, Backend)
.next/
dist/
out/
build/
.vercel/
.turbo/

# Testing & Test Reports
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Debug & Execution Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secret Files (Never commit real credentials)
.env
.env.*
.env*.local
.env.development
.env.test
.env.production
.env.staging

# DO NOT IGNORE environment templates / examples
!.env.example
!**/.env.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.pfx
*.p12

# TypeScript Cache & Auto-generated Definitions
*.tsbuildinfo
next-env.d.ts
.eslintcache

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
*.sublime-workspace
*.sublime-project
