# Backend Environment Variables (Production & Staging)
PORT=4000
NODE_ENV=production

# MySQL Database Connection String (InnoDB Engine)
DATABASE_URL="mysql://username:password@hostname:3306/database_name?sslaccept=strict"

# 64-Character Random Secret for Session JWT Signing
AUTH_SECRET="your-secure-random-64-character-jwt-secret-here"
# Alternatively JWT_SECRET
JWT_SECRET="your-secure-random-64-character-jwt-secret-here"

# Allowed Production Frontend Origin (Vercel deployment URL)
CORS_ORIGIN="https://your-app.vercel.app"
FRONTEND_URL="https://your-app.vercel.app"
